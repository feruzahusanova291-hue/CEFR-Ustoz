# 1-bot (Matematika) tokeni — @BotFather dan
TELEGRAM_BOT_TOKEN=

# 2-bot (CEFR English) tokeni — @BotFather dan ALOHIDA bot yarating, token boshqacha bo'ladi!
CEFR_BOT_TOKEN=

# https://aistudio.google.com/apikey dan olingan kalit
GEMINI_API_KEY=

# Model nomi (Google AI Studio'da mavjud modellarga qarab o'zgartirishingiz mumkin)
GEMINI_MODEL=gemini-3.5-flash

# Zaxira modellar (asosiy model band bo'lsa ishlatiladi, vergul bilan)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Ko'rsatma fayli (boshqa bot yaratganda faqat shuni almashtirasiz)
SYSTEM_INSTRUCTION_FILE=system_instruction.json

# Ixtiyoriy: xotirada saqlanadigan oxirgi xabarlar soni
MAX_HISTORY_MESSAGES=16

# Ixtiyoriy: xabarlar orasidagi minimal pauza (soniya)
COOLDOWN_SECONDS=2

# Ixtiyoriy: faqat shu Telegram ID'lar foydalana oladi (vergul bilan). Bo'sh = hamma.
ALLOWED_USER_IDS=

# 2-bot ko'rsatma fayli
CEFR_SYSTEM_INSTRUCTION_FILE=cefr_system_instruction.json
